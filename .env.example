# База данных (один из вариантов):
# PostgreSQL на Railway — Reference переменной DATABASE_URL из сервиса Postgres (приоритет над SQLite).
# DATABASE_URL=postgresql://...

# Либо SQLite (локально или том Railway /data):
# SQLITE_PATH=/data/career_bot.db

# Команда /stats: VK user id через запятую (числовой id страницы). Обязательно, если бот не видит вас в managers или в чате.
# STATS_ADMIN_IDS=123456789,987654321
# Лог входящих сообщений (отладка): STATS_DEBUG=1
# Секретная фраза для выгрузки (если /stats не доходит из клиента): STATS_EXPORT_SECRET=любая_фраза

# Long Poll (секунды ожидания ответа VK; таймаут HTTP в vk_api = wait + 10)
# VK_LONGPOLL_WAIT=50
# VK_LONGPOLL_RETRY_SLEEP=2
