# Образец переменных окружения. Не вставляйте реальные ключи в этот отслеживаемый файл.
# Реальные значения задаются локально в игнорируемом .env или в Variables Railway.

# VK-процесс (существующий bot.py)
VK_TOKEN=replace_with_vk_community_token
VK_GROUP_ID=123456789
DATABASE_URL=postgresql://user:password@host:5432/database

# SQLite только для локального одиночного запуска; отдельные VK/MAX сервисы должны
# использовать одну и ту же PostgreSQL DATABASE_URL.
# SQLITE_PATH=/data/career_bot.db

# VK /stats администраторы (VK user IDs, через запятую)
# STATS_ADMIN_IDS=123456789,987654321
# STATS_DEBUG=1
# STATS_EXPORT_SECRET=replace_with_random_phrase
# VK_LONGPOLL_WAIT=50
# VK_LONGPOLL_RETRY_SLEEP=2

# MAX-процесс (отдельный Railway web-сервис: python max_bot.py)
MAX_BOT_TOKEN=replace_with_max_bot_token
MAX_WEBHOOK_URL=https://your-max-service.up.railway.app/max/webhook
MAX_WEBHOOK_SECRET=replace_with_random_5_to_256_char_secret
# MAX_STATS_ADMIN_IDS=123456789,987654321
# MAX_API_BASE=https://platform-api2.max.ru
# MAX_CA_BUNDLE=/app/certs/mincifry-root.pem
